---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Hide the section navigation (e.g. on the 404 page). */
  bare?: boolean;
  noindex?: boolean;
}

const { title, description = site.description, bare = false, noindex = false } = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : site.title;
const base = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL('/og.png', base).href;
const headline = site.hero.headline.map((line) => line.map((w) => w.text).join(' ')).join(' ');

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.handle,
  url: site.url,
  ...(site.email && { email: `mailto:${site.email}` }),
  sameAs: Object.values(site.links).filter(Boolean),
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Delhi Technological University' },
  knowsAbout: ['C++', 'Low-latency systems', 'Data structures and algorithms'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#060a13" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.handle} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${headline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

    <!-- Enables reveal states; removed after 3 s if reveal.ts never ran. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!window.__revealReady) document.documentElement.classList.remove('js');
      }, 3000);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!bare && <SiteHeader />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />

    <script>
      import { initReveal } from '../scripts/reveal';

      initReveal();
    </script>
  </body>
</html>
