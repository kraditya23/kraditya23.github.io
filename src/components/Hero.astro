---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { lobBench } from '../data/projects';

const { hero } = site;

// Staggered delay per headline word.
let delay = 180;
const lines = hero.headline.map((words, li) => {
  if (li > 0) delay += 40;
  return words.map((w) => {
    const d = delay;
    delay += 70;
    return { ...w, delay: d };
  });
});

const rows = [
  { label: 'warmup', value: lobBench.warmup },
  { label: 'mixed ops', value: lobBench.ops },
  { label: 'price levels', value: lobBench.levels },
  { label: 'throughput', value: lobBench.throughput, hit: true },
  { label: 'avg per op', value: lobBench.perOp, hit: true },
];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap hero-in">
    <div class="eyebrow load" style="--d: 60ms">
      <p><b>{site.name}</b>{hero.tags.map((t) => <> / {t}</>)}</p>
      {hero.availability && (
        <p class="pill"><span class="dot" aria-hidden="true"></span>{hero.availability}</p>
      )}
    </div>

    <h1 class="punch" id="hero-title">
      {lines.map((words, li) => (
        <>
        {li > 0 && ' '}
        <span class="ln">
          {words.map((w, i) => (
            <>
              {i > 0 && ' '}
              <span class:list={['w', w.style === 'accent' && 'hl', w.style === 'underline' && 'ul']} style={`--d: ${w.delay}ms`}>
                {w.text}
              </span>
            </>
          ))}
          {words === lines.at(-1) && <span class="caret" aria-hidden="true"></span>}
        </span>
        </>
      ))}
    </h1>

    <div class="hero-row">
      <div class="load" style="--d: 900ms">
        <p class="lede" set:html={hero.lede} />
        <div class="ctas">
          <a class="btn btn-primary" href="#projects">See the work <Icon name="arrow-down" /></a>
          <a class="btn btn-ghost" href="#contact">Get in touch</a>
        </div>
      </div>

      <figure class="term load" style="--d: 1000ms">
        <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i><span>lob-engine · {lobBench.build}</span></div>
        <div class="term-body">
          <p class="t-cmd"><span class="t-p" aria-hidden="true">$ </span><span class="typed" style={`--chars: ${lobBench.command.length}`}>{lobBench.command}</span></p>
          <dl>
            {rows.map((r, i) => (
              <div class:list={['t-row', 'load', r.hit && 'hit']} style={`--d: ${2200 + i * 150}ms`}>
                <dt>{r.label}</dt>
                <dd>{r.value}</dd>
              </div>
            ))}
          </dl>
          <p class="t-prompt load" style="--d: 3000ms" aria-hidden="true"><span class="t-p">$ </span><span class="t-cur"></span></p>
        </div>
        <figcaption class="visually-hidden">Order book engine benchmark, run 1 on a {lobBench.machine}.</figcaption>
      </figure>
    </div>

    <a class="cue load" href="#about" style="--d: 1400ms"><span class="cue-line" aria-hidden="true"></span>Scroll</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse 65% 70% at 25% 35%, #000 15%, transparent 72%);
    mask-image: radial-gradient(ellipse 65% 70% at 25% 35%, #000 15%, transparent 72%);
  }

  .glow {
    position: absolute;
    left: -220px;
    top: -280px;
    width: 720px;
    height: 720px;
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 24%, transparent), transparent 65%);
  }

  .hero-in {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 40px;
    min-height: 720px;
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    color: var(--mute);
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .eyebrow p {
    margin: 0;
  }

  .eyebrow b {
    color: var(--ink);
    font-weight: 500;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border: 1px solid var(--line2);
    border-radius: 999px;
    background: rgb(11 18 32 / 0.7);
    color: var(--ink);
    font-size: 13px;
  }

  .dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .punch {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(40px, 9.4vw, 124px);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .ln {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .w {
    display: inline-block;
  }

  .ul {
    position: relative;
  }

  .ul::after {
    content: '';
    position: absolute;
    left: 0.02em;
    right: 0.02em;
    bottom: 0.02em;
    height: 0.06em;
    background: var(--accent);
    transform-origin: 0 50%;
  }

  .caret {
    display: inline-block;
    width: 0.07em;
    height: 0.78em;
    margin-left: 0.08em;
    background: var(--accent);
    vertical-align: -0.04em;
  }

  .hero-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 440px);
    align-items: end;
    gap: 40px;
  }

  .lede {
    max-width: 560px;
    margin: 0 0 28px;
    color: var(--mute);
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.6;
  }

  .lede :global(b) {
    color: var(--ink);
    font-weight: 500;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Terminal */
  .term {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line2);
    border-radius: 14px;
    background: rgb(9 14 26 / 0.92);
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.7);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
    font-size: 12px;
  }

  .term-bar i {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #1c2740;
  }

  .term-bar span {
    min-width: 0;
    margin-left: auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .term-body {
    padding: 16px 18px 18px;
    color: var(--mute);
    line-height: 1.85;
  }

  .term-body p,
  .term-body dl,
  .term-body dd {
    margin: 0;
  }

  .t-cmd {
    color: var(--ink);
    white-space: nowrap;
  }

  .t-p {
    color: var(--accent-ink);
  }

  .typed {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    white-space: nowrap;
  }

  .t-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .t-row dd {
    color: var(--ink);
    font-weight: 500;
  }

  .t-row.hit dd {
    color: var(--accent-ink);
  }

  .t-cur {
    display: inline-block;
    width: 8px;
    height: 15px;
    background: var(--accent);
    vertical-align: -2px;
  }

  .cue {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 12px;
    min-height: 44px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .cue:hover {
    color: var(--ink);
  }

  .cue-line {
    position: relative;
    width: 1px;
    height: 36px;
    overflow: hidden;
    background: var(--line2);
  }

  .cue-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: -12px;
    width: 1px;
    height: 12px;
    background: var(--accent);
  }

  /* Entrance animations: run once on load, skipped under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .load {
      animation: fade-up 0.9s var(--ease-out) var(--d, 0ms) both;
    }

    .t-row.load,
    .t-prompt.load {
      animation-duration: 0.5s;
    }

    .w {
      animation: rise 0.9s var(--ease-out) var(--d, 0ms) both;
    }

    .ul::after {
      animation: grow-x 0.8s var(--ease-out) 1.25s both;
    }

    .caret {
      animation:
        appear 0.01s linear 0.75s both,
        blink 1s steps(1) 1.4s 5;
    }

    .dot {
      animation: ping 2.4s ease-out 1.6s 3;
    }

    .typed {
      animation: typing 0.9s steps(var(--chars)) 1.2s both;
    }

    .t-cur {
      animation: blink 1s steps(1) 3.4s 6 both;
    }

    .cue-line::after {
      animation: drip 1.8s ease-in-out 2.6s 4;
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes rise {
    from {
      transform: translateY(108%);
    }
  }

  @keyframes grow-x {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes ping {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent);
    }
    to {
      box-shadow: 0 0 0 10px transparent;
    }
  }

  @keyframes typing {
    from {
      width: 0;
    }
    to {
      width: calc(var(--chars) * 1ch);
    }
  }

  @keyframes drip {
    to {
      transform: translateY(48px);
    }
  }

  @media (max-width: 960px) {
    .hero-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 600px) {
    .hero-in {
      min-height: 0;
    }

    .eyebrow {
      font-size: 12.5px;
    }

    .term {
      font-size: 12px;
    }
  }
</style>
