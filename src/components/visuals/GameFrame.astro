---
// Stylised game window: a Play link when `playUrl` is set, otherwise a status label.
import Icon from '../Icon.astro';

interface Props {
  title: string;
  repoName: string;
  year: string;
  playUrl: string;
}

const { title, repoName, year, playUrl } = Astro.props;
---

<figure class="game-fig">
  <div class="game">
    <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span class="gt">{repoName}</span><span>{year}</span></div>
    <div class="view">
      <div class="floor" aria-hidden="true"></div>
      <div class="hud" aria-hidden="true"><span>BOSS</span><span class="hp"><span class="hp-fill"></span></span></div>
      <div class="vs" aria-hidden="true">
        <Icon name="sword" size={46} class="ic-sword" />
        <span>VS</span>
        <Icon name="crosshair" size={46} class="ic-gun" />
      </div>
      {playUrl ? (
        <a class="play" href={playUrl}><Icon name="play" size={14} />Play {title} in the browser</a>
      ) : (
        <p class="play"><Icon name="play" size={14} />WebGL build · coming soon</p>
      )}
    </div>
  </div>
  {!playUrl && <figcaption>The playable build drops in here once the remaster ships</figcaption>}
</figure>

<style>
  .game-fig {
    margin: 0;
  }

  .game {
    overflow: hidden;
    border: 1px solid var(--line2);
    border-radius: var(--radius-md);
    background: #050810;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  .bar i {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #1c2740;
  }

  .gt {
    flex: 1;
    min-width: 0;
    margin-left: 6px;
    overflow: hidden;
    color: var(--mute);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .view {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }

  .floor {
    position: absolute;
    left: -50%;
    right: -50%;
    bottom: -2px;
    height: 58%;
    background-image:
      linear-gradient(color-mix(in srgb, var(--accent) 40%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--accent) 40%, transparent) 1px, transparent 1px);
    background-size:
      100% 22px,
      44px 100%;
    transform: perspective(260px) rotateX(58deg);
    transform-origin: 50% 100%;
    -webkit-mask-image: linear-gradient(to top, #000 30%, transparent);
    mask-image: linear-gradient(to top, #000 30%, transparent);
  }

  .hud {
    position: absolute;
    top: 14px;
    left: 16px;
    right: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ask);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
  }

  .hp {
    flex: 1;
    height: 10px;
    padding: 1px;
    border: 1px solid color-mix(in srgb, var(--ask) 60%, transparent);
    border-radius: 2px;
  }

  .hp-fill {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--ask);
    transform: scaleX(0.62);
    transform-origin: 0 50%;
  }

  .vs {
    position: relative;
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: -28px;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.2em;
  }

  .vs :global(.ic-sword) {
    color: var(--ask);
  }

  .vs :global(.ic-gun) {
    color: var(--accent-ink);
  }

  .play {
    position: absolute;
    bottom: 18px;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin: 0;
    padding: 0 18px;
    border: 1px solid var(--line2);
    border-radius: 999px;
    background: rgb(6 10 19 / 0.85);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 12.5px;
    text-decoration: none;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  a.play:hover {
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  figcaption {
    margin-top: 12px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 11.5px;
    text-align: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hp-fill {
      transition: transform 1.4s cubic-bezier(0.5, 0, 0.2, 1) 0.8s;
    }

    :global(.js .reveal:not(.is-visible)) .hp-fill {
      transform: scaleX(1);
    }
  }

  @media (max-width: 380px) {
    .play {
      font-size: 11.5px;
      padding: 0 14px;
    }
  }
</style>
