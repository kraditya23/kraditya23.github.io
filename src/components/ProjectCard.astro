---
// Project row. `side` sets the offset, reveal direction and (for "right") visual-first order.
import Icon from './Icon.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  side: 'left' | 'right';
}

const { project: p, side } = Astro.props;
const links = p.links.filter((l) => l.href);
const titleId = `project-${p.id}`;
---

<article class:list={['proj', side, 'reveal', side === 'left' ? 'reveal--left' : 'reveal--right']} aria-labelledby={titleId}>
  <div class="proj-text">
    {p.kicker && <p class="kicker">{p.kicker}</p>}
    <p class="meta">
      <span>{p.meta}</span>
      {p.status && <span class:list={['status', p.statusLive && 'live']}>{p.status}</span>}
    </p>
    <h3 id={titleId}>{p.title}</h3>
    <p class="lede" set:html={p.lede} />

    {p.metrics && p.metrics.length > 0 && (
      <dl class="metrics">
        {p.metrics.map((m) => (
          <div class="metric">
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
    )}

    {p.bullets && p.bullets.length > 0 && (
      <ul class="bul">
        {p.bullets.map((b) => <li set:html={b} />)}
      </ul>
    )}

    <ul class="chips" aria-label="Built with">
      {p.chips.map((c) => <li class="chip">{c}</li>)}
    </ul>

    {links.length > 0 && (
      <div class="links">
        {links.map((l, i) => (
          <a class:list={['lnk', i > 0 && 'lnk--muted']} href={l.href} rel="noopener">
            {l.label} <Icon name="external" />
          </a>
        ))}
      </div>
    )}
  </div>
  <div class="proj-vis">
    <slot />
  </div>
</article>

<style>
  .proj {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 4vw, 56px);
    width: min(100%, 1040px);
    padding: clamp(22px, 3vw, 40px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--s1);
    transition: border-color 0.3s;
  }

  .proj:hover {
    border-color: var(--line2);
  }

  .proj.left {
    margin-right: auto;
  }

  .proj.right {
    margin-left: auto;
  }

  .proj.right .proj-vis {
    order: -1;
  }

  .kicker {
    margin: 0 0 10px;
    color: var(--ask);
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }

  .status {
    padding: 4px 10px;
    border: 1px solid var(--line2);
    border-radius: 999px;
    color: var(--mute);
  }

  .status.live {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    color: var(--accent-ink);
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(26px, 2.8vw, 36px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: 14px 0 0;
    color: var(--mute);
    font-size: 16.5px;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 22px 0 0;
  }

  .metric {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--s2);
  }

  .metric dd {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.1;
  }

  .metric dt {
    margin-top: 4px;
    color: var(--mute);
    font-size: 12.5px;
  }

  .bul {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .bul li {
    position: relative;
    padding-left: 20px;
    color: var(--mute);
    font-size: 15px;
    line-height: 1.55;
  }

  .bul li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.7em;
    width: 8px;
    height: 2px;
    background: var(--accent);
  }

  .bul :global(code) {
    padding: 1px 6px;
    border-radius: 5px;
    background: var(--s2);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.88em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 22px;
    margin-top: 18px;
  }

  @media (max-width: 960px) {
    .proj {
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
    }

    .proj.right .proj-vis {
      order: 0;
    }
  }

  @media (max-width: 600px) {
    .metrics {
      gap: 8px;
    }

    .metric {
      padding: 10px;
    }

    .metric dd {
      font-size: 18px;
    }
  }
</style>
